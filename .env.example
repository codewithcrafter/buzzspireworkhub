# BUZZSPIRE WORKHUB - Production & Development Environment Template

# PostgreSQL Database Connection URL (Neon / Standard Postgres)
DATABASE_URL="postgresql://username:password@ep-project-pooler.region.aws.neon.tech/buzzspire_workhub?sslmode=require"

# Direct URL for Prisma migrations (Neon direct session connection)
DIRECT_URL="postgresql://username:password@ep-project-direct.region.aws.neon.tech/buzzspire_workhub?sslmode=require"

# JWT Secret Key for Session Authentication (At least 32 characters)
JWT_SECRET="your_production_secure_random_jwt_secret_key_change_me"

# Public Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Initial Administrator Seed Password (used by prisma/seed.ts)
ADMIN_SEED_PASSWORD="YourSecureAdminSeedPassword123!"

# Node Environment (development | production | test)
NODE_ENV="development"
