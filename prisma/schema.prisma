generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String           @id @default(uuid())
  email             String           @unique
  password          String?
  name              String
  role              Role             @default(CLIENT)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  company           String?
  invitationExpires DateTime?
  invitationToken   String?          @unique
  phone             String?
  employeeId        String?          @unique
  permissions       String[]         @default([])
  status            UserStatus       @default(ACTIVE)
  contractAmount    Float            @default(0)
  aiUsage           AiUsageHistory[]
  employeeProfile   Employee?
  invoices          Invoice[]
  assignedLeads     Lead[]           @relation("AssignedLeads")
  projects          Project[]
  tickets           Ticket[]
  clientPayments    ClientPayment[]
  clientUsages      ClientUsage[]
  clientUpdates     ClientUpdate[]
  leadReminders     LeadReminder[]
  leadNotes         LeadNote[]
  leadActivities    LeadActivity[]
}

model Project {
  id               String           @id @default(uuid())
  title            String
  description      String?
  status           ProjectStatus    @default(PLANNING)
  clientId         String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  progress         Int              @default(0)
  progressStages   Json?
  showDeliverables Boolean          @default(true)
  showDownloads    Boolean          @default(true)
  showFiles        Boolean          @default(true)
  showInvoices     Boolean          @default(true)
  showMessages     Boolean          @default(true)
  showPayments     Boolean          @default(true)
  showProgress     Boolean          @default(true)
  showTickets      Boolean          @default(true)
  showTimeline     Boolean          @default(true)
  invoices         Invoice[]
  client           User             @relation(fields: [clientId], references: [id])
  files            ProjectFile[]
  messages         ProjectMessage[]
  updates          ProjectUpdate[]
  milestones       ProjectMilestone[]

  @@index([clientId])
  @@index([createdAt])
}

model ProjectUpdate {
  id          String   @id @default(uuid())
  projectId   String
  title       String
  description String
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectFile {
  id            String   @id @default(uuid())
  projectId     String
  name          String
  url           String
  size          Int
  category      String
  clientVisible Boolean  @default(true)
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectMessage {
  id          String   @id @default(uuid())
  projectId   String
  senderId    String
  recipientId String
  text        String
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Lead {
  id                 String         @id @default(uuid())
  name               String?
  email              String?
  company            String?
  message            String?
  status             LeadStatus     @default(NEW)
  createdAt          DateTime       @default(now())
  budget             String?
  pageUrl            String?
  phone              String?
  portfolio          String?
  service            String?
  source             String?
  assignedEmployeeId String?
  notes              String?
  priority           LeadPriority   @default(MEDIUM)
  isArchived         Boolean        @default(false)
  followUpAt         DateTime?
  updatedAt          DateTime       @default(now()) @updatedAt
  assignedEmployee   User?          @relation("AssignedLeads", fields: [assignedEmployeeId], references: [id])
  chatSession        ChatSession?
  reminders          LeadReminder[]
  internalNotes      LeadNote[]
  activities         LeadActivity[]

  @@index([assignedEmployeeId])
  @@index([status])
  @@index([createdAt])
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String
  employeeId String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  lead      Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  employee  User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  @@index([leadId])
}

model LeadActivity {
  id         String   @id @default(uuid())
  leadId     String
  employeeId String? // the user who did the action, null if system
  action     String   // e.g. "Status changed", "Customer Message updated"
  details    String?  // e.g. "NEW -> CONTACTED"
  createdAt  DateTime @default(now())
  
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  employee   User?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  
  @@index([leadId])
}

model Ticket {
  id          String        @id @default(uuid())
  subject     String
  description String
  status      TicketStatus  @default(OPEN)
  clientId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  client      User          @relation(fields: [clientId], references: [id])
  replies     TicketReply[]

  @@index([clientId])
  @@index([status])
}

model TicketReply {
  id        String   @id @default(uuid())
  ticketId  String
  senderId  String
  text      String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Blog {
  id              String     @id @default(uuid())
  title           String
  slug            String     @unique
  excerpt         String
  content         String
  featuredImage   String?
  category        String
  tags            String[]
  author          String
  readTime        Int        @default(5)
  seoTitle        String?
  metaDescription String?
  status          BlogStatus @default(DRAFT)
  isFeatured      Boolean    @default(false)
  publishedAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  faqs            BlogFAQ[]

  @@index([slug])
  @@index([status])
}

model BlogFAQ {
  id        String   @id @default(uuid())
  blogId    String
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId])
}

model Invoice {
  id            String        @id @default(uuid())
  clientId      String
  projectId     String?
  invoiceNumber String?
  service       String?
  description   String?
  amount        Float
  subtotal      Float?
  tax           Float?
  discount      Float?
  notes         String?
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  client        User          @relation(fields: [clientId], references: [id])
  project       Project?      @relation(fields: [projectId], references: [id])
  payments      Payment[]

  @@index([clientId])
  @@index([projectId])
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String
  amount        Float
  method        String?
  transactionId String?
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model AdminTask {
  id        String   @id @default(uuid())
  title     String
  completed Boolean  @default(false)
  dueDate   String?
  priority  String   @default("low")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id        String   @id @default(uuid())
  user      String
  avatar    String
  action    String
  target    String
  type      String
  createdAt DateTime @default(now())
}

model AiPromptTemplate {
  id        String   @id @default(uuid())
  name      String
  category  String
  prompt    String
  createdAt DateTime @default(now())
}

model AiUsageHistory {
  id        String   @id @default(uuid())
  userId    String
  action    String
  tokens    Int
  prompt    String
  response  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AutomationWorkflow {
  id         String           @id @default(uuid())
  name       String
  trigger    String
  conditions Json?
  isActive   Boolean          @default(false)
  createdAt  DateTime         @default(now())
  actions    WorkflowAction[]
}

model WorkflowAction {
  id         String             @id @default(uuid())
  workflowId String
  type       String
  config     Json
  workflow   AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

model Campaign {
  id        String   @id @default(uuid())
  title     String
  budget    Float
  status    String   @default("DRAFT")
  channels  String[]
  roi       Float?
  createdAt DateTime @default(now())
}

model Prospect {
  id        String    @id @default(uuid())
  name      String
  company   String?
  email     String
  score     Int       @default(0)
  stage     String    @default("LEAD")
  createdAt DateTime  @default(now())
  calls     CallLog[]
  meetings  Meeting[]
}

model Meeting {
  id         String   @id @default(uuid())
  prospectId String
  date       DateTime
  notes      String?
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId])
}

model CallLog {
  id         String   @id @default(uuid())
  prospectId String
  duration   Int
  outcome    String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId])
}

model Department {
  id        String     @id @default(uuid())
  name      String     @unique
  employees Employee[]
}

model Employee {
  id           String      @id @default(uuid())
  userId       String      @unique
  departmentId String?
  salary       Float?
  role         String?
  designation  String?
  department   Department? @relation(fields: [departmentId], references: [id])
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KbArticle {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String
  isSop     Boolean  @default(false)
  createdAt DateTime @default(now())
}

model CloudFolder {
  id       String      @id @default(uuid())
  name     String
  parentId String?
  files    CloudFile[]
}

model CloudFile {
  id        String       @id @default(uuid())
  folderId  String?
  url       String
  size      Int
  mimeType  String
  altText   String?
  createdAt DateTime     @default(now())
  fileName  String?
  height    Int?
  name      String?
  updatedAt DateTime     @updatedAt
  width     Int?
  folder    CloudFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
}

model IntegrationConfig {
  id       String  @id @default(uuid())
  provider String  @unique
  apiKey   String?
  status   String  @default("DISCONNECTED")
}

model Page {
  id               String         @id @default(uuid())
  title            String
  slug             String         @unique
  status           PageStatus     @default(DRAFT)
  seoTitle         String?
  metaDescription  String?
  publishedContent Json?
  publishedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  revisions        PageRevision[]
  sections         PageSection[]
}

model PageSection {
  id          String   @id @default(uuid())
  pageId      String
  sectionType String
  order       Int
  isEnabled   Boolean  @default(true)
  content     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model PageRevision {
  id        String   @id @default(uuid())
  pageId    String
  version   Int
  content   Json
  createdAt DateTime @default(now())
  createdBy String?
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

enum Role {
  ADMIN
  CLIENT
  EDITOR
  EMPLOYEE
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum BlogStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ChatSession {
  id           String        @id @default(uuid())
  leadId       String        @unique
  status       ChatStatus    @default(WAITING)
  visitorName  String
  visitorEmail String
  visitorPhone String?
  service      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]
  voiceCalls   VoiceCall[]

  @@index([status])
  @@index([leadId])
}

model ChatMessage {
  id          String      @id @default(uuid())
  sessionId   String
  senderType  SenderType
  message     String
  createdAt   DateTime    @default(now())
  session     ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

enum ChatStatus {
  WAITING
  ACTIVE
  CLOSED
}

enum SenderType {
  VISITOR
  AGENT
  SYSTEM
}

model VoiceCall {
  id         String          @id @default(uuid())
  sessionId  String
  status     VoiceCallStatus @default(RINGING)
  startedAt  DateTime        @default(now())
  answeredAt DateTime?
  endedAt    DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  session    ChatSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  signals    CallSignal[]

  @@index([sessionId])
  @@index([status])
}

enum VoiceCallStatus {
  RINGING
  ACTIVE
  ENDED
  REJECTED
  MISSED
}

model CallSignal {
  id         String     @id @default(uuid())
  callId     String
  senderType SenderType
  type       String
  payload    Json
  createdAt  DateTime   @default(now())
  call       VoiceCall  @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
}

model ClientPayment {
  id          String   @id @default(uuid())
  clientId    String
  amount      Float
  date        DateTime @default(now())
  description String
  method      String?
  status      String   @default("PAID")
  createdAt   DateTime @default(now())
  client      User     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ClientUsage {
  id          String   @id @default(uuid())
  clientId    String
  description String
  category    String
  amount      Float
  date        DateTime @default(now())
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      User     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ProjectMilestone {
  id          String   @id @default(uuid())
  projectId   String
  title       String
  description String?
  status      String   @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  progress    Int      @default(0) // Completion percentage
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ClientUpdate {
  id          String   @id @default(uuid())
  clientId    String
  title       String
  message     String
  author      String
  createdAt   DateTime @default(now())
  client      User     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model LeadReminder {
  id          String   @id @default(uuid())
  title       String
  note        String?
  dueDate     DateTime
  status      String   @default("PENDING") // PENDING, COMPLETED, CANCELLED
  isNotified  Boolean  @default(false)
  leadId      String
  employeeId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  employee    User     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  
  @@index([leadId])
  @@index([employeeId])
  @@index([dueDate])
  @@index([status])
}
