generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS FOR BUZZSPIRE WORKHUB
// ==========================================

enum RoleName {
  ADMIN
  EMPLOYEE
  MANAGER
  HR_MANAGER
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  TERMINATED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LATE
  ON_LEAVE
  HOLIDAY
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

// ==========================================
// 13 CORE DATABASE ENTITIES (PHASE 3)
// ==========================================

// 1. Role Model
model Role {
  id          String     @id @default(uuid())
  name        RoleName   @unique
  description String?
  status      String     @default("ACTIVE")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[]
}

// 2. Department Model
model Department {
  id          String     @id @default(uuid())
  code        String     @unique
  name        String     @unique
  description String?
  manager     String?
  status      String     @default("ACTIVE")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  employees   Employee[]
}

// 3. Employee Model
model Employee {
  id                  String         @id @default(uuid())
  employeeId          String         @unique
  employeeCode        String         @unique
  fullName            String
  email               String         @unique
  phone               String?
  passwordHash        String
  roleId              String
  departmentId        String?
  designation         String?
  joiningDate         DateTime?
  shiftStart          String?
  shiftEnd            String?
  hourlyRate          Float?
  monthlySalary       Float?
  avatar              String?
  status              EmployeeStatus @default(ACTIVE)
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  passwordResetToken  String?
  passwordResetExpiry DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relations
  role               Role                   @relation(fields: [roleId], references: [id])
  department         Department?            @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  attendances        Attendance[]
  attendanceSessions AttendanceSession[]
  loginSessions      LoginSession[]
  activityLogs       ActivityLog[]
  auditLogs          AuditLog[]
  leaves             Leave[]                @relation("EmployeeLeaves")
  reviewedLeaves     Leave[]                @relation("ReviewedLeaves")
  notifications      Notification[]
  agentDevices       AgentDevice[]
  agentEnrollments   AgentEnrollmentToken[]

  // Optional reference for legacy User model integration if present
  userId         String?         @unique
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  payrollRecords PayrollRecord[]

  @@index([roleId])
  @@index([departmentId])
  @@index([email])
  @@index([employeeId])
  @@index([status])
}

// 4. Attendance Model
model Attendance {
  id                  String           @id @default(uuid())
  employeeId          String
  date                DateTime
  checkIn             DateTime?
  checkOut            DateTime?
  status              AttendanceStatus @default(PRESENT)
  totalWorkingSeconds Int              @default(0)
  totalBreakSeconds   Int              @default(0)
  netWorkingSeconds   Int              @default(0)
  isLate              Boolean          @default(false)
  lateMinutes         Int              @default(0)
  earlyLogoutMinutes  Int              @default(0)
  overtimeMinutes     Int              @default(0)
  shortfallMinutes    Int              @default(0)
  idleSeconds         Int              @default(0)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  employee Employee            @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  sessions AttendanceSession[]

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
  @@index([status])
}

// 5. Attendance Session Model
model AttendanceSession {
  id             String    @id @default(uuid())
  attendanceId   String
  employeeId     String
  punchIn        DateTime
  punchOut       DateTime?
  workingSeconds Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  breaks     Break[]

  @@index([attendanceId])
  @@index([employeeId])
}

// 6. Break Type Model
model BreakType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  breaks      Break[]
}

// 7. Break Model
model Break {
  id                  String    @id @default(uuid())
  attendanceSessionId String
  breakTypeId         String
  purpose             String?
  startTime           DateTime
  endTime             DateTime?
  durationSeconds     Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  attendanceSession AttendanceSession @relation(fields: [attendanceSessionId], references: [id], onDelete: Cascade)
  breakType         BreakType         @relation(fields: [breakTypeId], references: [id])

  @@index([attendanceSessionId])
  @@index([breakTypeId])
}

// 8. Login Session Model
model LoginSession {
  id           String    @id @default(uuid())
  employeeId   String
  sessionToken String    @unique
  ipAddress    String?
  userAgent    String?
  expiresAt    DateTime
  lastActivity DateTime? @default(now())
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([sessionToken])
  @@index([expiresAt])
}

// 9. Activity Log Model
model ActivityLog {
  id          String   @id @default(uuid())
  employeeId  String?
  action      String
  module      String
  resource    String?
  resourceId  String?
  description String
  metadata    Json?
  createdAt   DateTime @default(now())

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([createdAt])
  @@index([action])
}

// 10. Leave Model
model Leave {
  id              String      @id @default(uuid())
  employeeId      String
  leaveType       String
  startDate       DateTime
  endDate         DateTime
  totalDays       Float
  reason          String
  status          LeaveStatus @default(PENDING)
  rejectionReason String?
  reviewedBy      String?
  reviewedAt      DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  employee Employee  @relation("EmployeeLeaves", fields: [employeeId], references: [id], onDelete: Cascade)
  reviewer Employee? @relation("ReviewedLeaves", fields: [reviewedBy], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

// 11. Holiday Model
model Holiday {
  id          String   @id @default(uuid())
  name        String
  date        DateTime
  type        String
  description String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([name, date])
  @@index([date])
}

// 12. System Setting Model
model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

// 13. Audit Log Model
model AuditLog {
  id          String   @id @default(uuid())
  employeeId  String?
  action      String
  module      String
  resource    String?
  resourceId  String?
  description String
  ipAddress   String?
  userAgent   String?
  metadata    Json?
  requestId   String?
  createdAt   DateTime @default(now())

  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([createdAt])
  @@index([action])
  @@index([module])
}

// 14. Notification Model
model Notification {
  id         String    @id @default(uuid())
  employeeId String
  type       String
  title      String
  message    String
  readAt     DateTime?
  metadata   Json?
  createdAt  DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@index([readAt])
  @@index([createdAt])
}

// ==========================================
// LEGENCY / AUXILIARY AGENCY MODELS (PRESERVED)
// ==========================================

model User {
  id                String           @id @default(uuid())
  email             String           @unique
  password          String?
  name              String
  role              RoleType         @default(CLIENT)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  company           String?
  invitationExpires DateTime?
  invitationToken   String?          @unique
  phone             String?
  employeeId        String?          @unique
  permissions       String[]         @default([])
  status            UserStatus       @default(ACTIVE)
  contractAmount    Float            @default(0)
  aiUsage           AiUsageHistory[]
  employeeProfile   Employee?
  invoices          Invoice[]
  assignedLeads     Lead[]           @relation("AssignedLeads")
  projects          Project[]
  tickets           Ticket[]
  clientPayments    ClientPayment[]
  clientUsages      ClientUsage[]
  clientUpdates     ClientUpdate[]
  leadReminders     LeadReminder[]
  leadNotes         LeadNote[]
  leadActivities    LeadActivity[]
}

enum RoleType {
  ADMIN
  CLIENT
  EDITOR
  EMPLOYEE
}

model Project {
  id               String             @id @default(uuid())
  title            String
  description      String?
  status           ProjectStatus      @default(PLANNING)
  clientId         String
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  progress         Int                @default(0)
  progressStages   Json?
  showDeliverables Boolean            @default(true)
  showDownloads    Boolean            @default(true)
  showFiles        Boolean            @default(true)
  showInvoices     Boolean            @default(true)
  showMessages     Boolean            @default(true)
  showPayments     Boolean            @default(true)
  showProgress     Boolean            @default(true)
  showTickets      Boolean            @default(true)
  showTimeline     Boolean            @default(true)
  invoices         Invoice[]
  client           User               @relation(fields: [clientId], references: [id])
  files            ProjectFile[]
  messages         ProjectMessage[]
  updates          ProjectUpdate[]
  milestones       ProjectMilestone[]

  @@index([clientId])
  @@index([createdAt])
}

model ProjectUpdate {
  id          String   @id @default(uuid())
  projectId   String
  title       String
  description String
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectFile {
  id            String   @id @default(uuid())
  projectId     String
  name          String
  url           String
  size          Int
  category      String
  clientVisible Boolean  @default(true)
  createdAt     DateTime @default(now())
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ProjectMessage {
  id          String   @id @default(uuid())
  projectId   String
  senderId    String
  recipientId String
  text        String
  createdAt   DateTime @default(now())
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model Lead {
  id                 String         @id @default(uuid())
  name               String?
  email              String?
  company            String?
  message            String?
  status             LeadStatus     @default(NEW)
  createdAt          DateTime       @default(now())
  budget             String?
  pageUrl            String?
  phone              String?
  portfolio          String?
  service            String?
  source             String?
  assignedEmployeeId String?
  notes              String?
  priority           LeadPriority   @default(MEDIUM)
  isArchived         Boolean        @default(false)
  followUpAt         DateTime?
  updatedAt          DateTime       @default(now()) @updatedAt
  assignedEmployee   User?          @relation("AssignedLeads", fields: [assignedEmployeeId], references: [id])
  chatSession        ChatSession?
  reminders          LeadReminder[]
  internalNotes      LeadNote[]
  activities         LeadActivity[]

  @@index([assignedEmployeeId])
  @@index([status])
  @@index([createdAt])
}

model LeadNote {
  id         String   @id @default(uuid())
  leadId     String
  employeeId String
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lead     Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  employee User @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model LeadActivity {
  id         String   @id @default(uuid())
  leadId     String
  employeeId String?
  action     String
  details    String?
  createdAt  DateTime @default(now())

  lead     Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  employee User? @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([leadId])
}

model Ticket {
  id          String        @id @default(uuid())
  subject     String
  description String
  status      TicketStatus  @default(OPEN)
  clientId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  client      User          @relation(fields: [clientId], references: [id])
  replies     TicketReply[]

  @@index([clientId])
  @@index([status])
}

model TicketReply {
  id        String   @id @default(uuid())
  ticketId  String
  senderId  String
  text      String
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
}

model Blog {
  id              String     @id @default(uuid())
  title           String
  slug            String     @unique
  excerpt         String
  content         String
  featuredImage   String?
  category        String
  tags            String[]
  author          String
  authorId        String?
  authorProfile   Author?    @relation(fields: [authorId], references: [id])
  readTime        Int        @default(5)
  seoTitle        String?
  metaDescription String?
  status          BlogStatus @default(DRAFT)
  isFeatured      Boolean    @default(false)
  publishedAt     DateTime?
  scheduledAt     DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  faqs            BlogFAQ[]

  @@index([slug])
  @@index([status])
  @@index([authorId])
}

model BlogFAQ {
  id        String   @id @default(uuid())
  blogId    String
  question  String
  answer    String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blog      Blog     @relation(fields: [blogId], references: [id], onDelete: Cascade)

  @@index([blogId])
}

model Invoice {
  id            String        @id @default(uuid())
  clientId      String
  projectId     String?
  invoiceNumber String?
  service       String?
  description   String?
  amount        Float
  subtotal      Float?
  tax           Float?
  discount      Float?
  notes         String?
  status        InvoiceStatus @default(DRAFT)
  dueDate       DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  client        User          @relation(fields: [clientId], references: [id])
  project       Project?      @relation(fields: [projectId], references: [id])
  payments      Payment[]

  @@index([clientId])
  @@index([projectId])
}

model Payment {
  id            String        @id @default(uuid())
  invoiceId     String
  amount        Float
  method        String?
  transactionId String?
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  invoice       Invoice       @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model AdminTask {
  id        String   @id @default(uuid())
  title     String
  completed Boolean  @default(false)
  dueDate   String?
  priority  String   @default("low")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AiPromptTemplate {
  id        String   @id @default(uuid())
  name      String
  category  String
  prompt    String
  createdAt DateTime @default(now())
}

model AiUsageHistory {
  id        String   @id @default(uuid())
  userId    String
  action    String
  tokens    Int
  prompt    String
  response  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AutomationWorkflow {
  id         String           @id @default(uuid())
  name       String
  trigger    String
  conditions Json?
  isActive   Boolean          @default(false)
  createdAt  DateTime         @default(now())
  actions    WorkflowAction[]
}

model WorkflowAction {
  id         String             @id @default(uuid())
  workflowId String
  type       String
  config     Json
  workflow   AutomationWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
}

model Campaign {
  id        String   @id @default(uuid())
  title     String
  budget    Float
  status    String   @default("DRAFT")
  channels  String[]
  roi       Float?
  createdAt DateTime @default(now())
}

model Prospect {
  id        String    @id @default(uuid())
  name      String
  company   String?
  email     String
  score     Int       @default(0)
  stage     String    @default("LEAD")
  createdAt DateTime  @default(now())
  calls     CallLog[]
  meetings  Meeting[]
}

model Meeting {
  id         String   @id @default(uuid())
  prospectId String
  date       DateTime
  notes      String?
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId])
}

model CallLog {
  id         String   @id @default(uuid())
  prospectId String
  duration   Int
  outcome    String
  prospect   Prospect @relation(fields: [prospectId], references: [id], onDelete: Cascade)

  @@index([prospectId])
}

model KbArticle {
  id        String   @id @default(uuid())
  title     String
  content   String
  category  String
  isSop     Boolean  @default(false)
  createdAt DateTime @default(now())
}

model CloudFolder {
  id       String      @id @default(uuid())
  name     String
  parentId String?
  files    CloudFile[]
}

model CloudFile {
  id        String       @id @default(uuid())
  folderId  String?
  url       String
  size      Int
  mimeType  String
  altText   String?
  createdAt DateTime     @default(now())
  fileName  String?
  height    Int?
  name      String?
  updatedAt DateTime     @updatedAt
  width     Int?
  folder    CloudFolder? @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
}

model IntegrationConfig {
  id       String  @id @default(uuid())
  provider String  @unique
  apiKey   String?
  status   String  @default("DISCONNECTED")
}

model Page {
  id               String         @id @default(uuid())
  title            String
  slug             String         @unique
  status           PageStatus     @default(DRAFT)
  seoTitle         String?
  metaDescription  String?
  publishedContent Json?
  publishedAt      DateTime?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  revisions        PageRevision[]
  sections         PageSection[]
}

model PageSection {
  id          String   @id @default(uuid())
  pageId      String
  sectionType String
  order       Int
  isEnabled   Boolean  @default(true)
  content     Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  page        Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model PageRevision {
  id        String   @id @default(uuid())
  pageId    String
  version   Int
  content   Json
  createdAt DateTime @default(now())
  createdBy String?
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CLOSED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum BlogStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum PageStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ChatSession {
  id           String        @id @default(uuid())
  leadId       String        @unique
  status       ChatStatus    @default(WAITING)
  visitorName  String
  visitorEmail String
  visitorPhone String?
  service      String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  messages     ChatMessage[]
  voiceCalls   VoiceCall[]

  @@index([status])
  @@index([leadId])
}

model ChatMessage {
  id         String      @id @default(uuid())
  sessionId  String
  senderType SenderType
  message    String
  createdAt  DateTime    @default(now())
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

enum ChatStatus {
  WAITING
  ACTIVE
  CLOSED
}

enum SenderType {
  VISITOR
  AGENT
  SYSTEM
}

model VoiceCall {
  id         String          @id @default(uuid())
  sessionId  String
  status     VoiceCallStatus @default(RINGING)
  startedAt  DateTime        @default(now())
  answeredAt DateTime?
  endedAt    DateTime?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  session    ChatSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  signals    CallSignal[]

  @@index([sessionId])
  @@index([status])
}

enum VoiceCallStatus {
  RINGING
  ACTIVE
  ENDED
  REJECTED
  MISSED
}

model CallSignal {
  id         String     @id @default(uuid())
  callId     String
  senderType SenderType
  type       String
  payload    Json
  createdAt  DateTime   @default(now())
  call       VoiceCall  @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
}

model ClientPayment {
  id          String   @id @default(uuid())
  clientId    String
  amount      Float
  date        DateTime @default(now())
  description String
  method      String?
  status      String   @default("PAID")
  createdAt   DateTime @default(now())
  client      User     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ClientUsage {
  id          String   @id @default(uuid())
  clientId    String
  description String
  category    String
  amount      Float
  date        DateTime @default(now())
  note        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  client      User     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model ProjectMilestone {
  id          String   @id @default(uuid())
  projectId   String
  title       String
  description String?
  status      String   @default("PENDING")
  progress    Int      @default(0)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model ClientUpdate {
  id        String   @id @default(uuid())
  clientId  String
  title     String
  message   String
  author    String
  createdAt DateTime @default(now())
  client    User     @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model LeadReminder {
  id         String   @id @default(uuid())
  title      String
  note       String?
  dueDate    DateTime
  status     String   @default("PENDING")
  isNotified Boolean  @default(false)
  leadId     String
  employeeId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lead     Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  employee User @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([employeeId])
  @@index([dueDate])
  @@index([status])
}

model Author {
  id           String   @id @default(uuid())
  name         String
  photoUrl     String?
  designation  String?
  bio          String?
  facebookUrl  String?
  instagramUrl String?
  linkedinUrl  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  blogs        Blog[]
}

enum CaseStudyStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model CaseStudy {
  id               String          @id @default(uuid())
  title            String
  slug             String          @unique
  clientName       String
  industry         String
  shortDescription String
  featuredImage    String?
  services         String[]
  projectOverview  String
  challenge        String
  objectives       String[]
  strategy         String
  execution        Json
  results          Json
  heroMetric       Json
  conclusion       String
  testimonial      Json?
  seoTitle         String?
  metaDescription  String?
  canonicalUrl     String?
  status           CaseStudyStatus @default(DRAFT)
  isDemo           Boolean         @default(false)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([slug])
  @@index([status])
  @@index([industry])
}

// ==========================================
// NEW: WINDOWS ACTIVITY AGENT MODELS
// ==========================================

// 1. Enrollment Tokens for Agent Setup
model AgentEnrollmentToken {
  id         String   @id @default(uuid())
  token      String   @unique
  employeeId String
  expiresAt  DateTime
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// 2. Authenticated Agent Devices
model AgentDevice {
  id           String    @id @default(uuid())
  deviceId     String    @unique // Secure hardware-derived ID or UUID
  employeeId   String
  credential   String    @unique // The secret key the agent uses to authenticate
  agentVersion String?
  deviceName   String?
  status       String    @default("ACTIVE") // ACTIVE, REVOKED
  lastSeenAt   DateTime?
  enrolledAt   DateTime  @default(now())
  revokedAt    DateTime?

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

// ==========================================
// PHASE D: PAYROLL & SALARY ENGINE
// ==========================================

enum PayrollStatus {
  DRAFT
  CALCULATED
  APPROVED
  PAID
}

enum SalaryType {
  MONTHLY
  HOURLY
}

model PayrollRun {
  id              String        @id @default(uuid())
  month           Int // 1-12
  year            Int // e.g. 2026
  periodStart     DateTime
  periodEnd       DateTime
  status          PayrollStatus @default(DRAFT)
  totalEmployees  Int           @default(0)
  totalGrossPay   Float         @default(0)
  totalDeductions Float         @default(0)
  totalNetPay     Float         @default(0)
  processedBy     String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  records PayrollRecord[]

  @@unique([month, year])
}

model PayrollRecord {
  id           String @id @default(uuid())
  payrollRunId String
  employeeId   String

  // Snapshots at time of calculation
  salaryType         SalaryType
  baseMonthlySalary  Float?
  baseHourlyRate     Float?
  workingDaysMode    String? // "CALENDAR_DAYS" or "WORKING_DAYS"
  workingDaysDivisor Float?
  departmentSnapshot Json?

  // Time Metrics (Minutes)
  expectedMinutes    Int @default(0)
  workingMinutes     Int @default(0)
  shortfallMinutes   Int @default(0)
  overtimeMinutes    Int @default(0)
  lateMinutes        Int @default(0)
  earlyLogoutMinutes Int @default(0)

  // Day Metrics
  workingDays     Float @default(0)
  presentDays     Float @default(0)
  absentDays      Float @default(0)
  paidLeaveDays   Float @default(0)
  unpaidLeaveDays Float @default(0)
  holidayDays     Float @default(0)
  weekendDays     Float @default(0)
  halfDays        Float @default(0)

  // Financial Metrics
  basePay         Float @default(0)
  overtimePay     Float @default(0)
  grossPay        Float @default(0)
  totalDeductions Float @default(0)
  netPay          Float @default(0)

  status                   PayrollStatus @default(DRAFT)
  calculationPolicyVersion String        @default("PAYROLL_V1")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payrollRun PayrollRun         @relation(fields: [payrollRunId], references: [id], onDelete: Cascade)
  employee   Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  deductions PayrollDeduction[]

  @@unique([payrollRunId, employeeId])
  @@index([employeeId])
}

model PayrollDeduction {
  id              String    @id @default(uuid())
  payrollRecordId String
  type            String // "ABSENT", "UNPAID_LEAVE", "LATE", "EARLY_LOGOUT", "SHORTFALL", "HALF_DAY"
  date            DateTime? // The specific date this deduction occurred
  minutes         Int? // The raw minutes deducted (if applicable)
  amount          Float // The financial value deducted
  description     String?
  createdAt       DateTime  @default(now())

  payrollRecord PayrollRecord @relation(fields: [payrollRecordId], references: [id], onDelete: Cascade)

  @@index([payrollRecordId])
}
